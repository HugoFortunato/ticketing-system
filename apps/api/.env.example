REDIS_URL=redis://localhost:6379
# false = Postgres em todo GET /events. true = cache Redis.
EVENTS_CACHE_ENABLED=true
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
RESERVATION_TTL_SECONDS=600
EVENTS_CACHE_TTL_SECONDS=60
